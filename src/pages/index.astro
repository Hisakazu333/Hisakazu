---
import Base from '../layouts/Base.astro';

const publications = [
  {
    title:
      'Self-Certification of Representation Adequacy: Sequential Certification at Minimum Task Loss',
    meta: 'arXiv:2608.02267 [cs.AI] · Aug 2026',
    url: 'https://arxiv.org/abs/2608.02267',
  },
];

const projects = [
  {
    name: 'NekoDrop',
    meta: 'Local-first LAN file transfer for macOS & Windows — trusted pairing, encrypted sessions, resume support. Rust · Tauri',
    url: 'https://github.com/Hisakazu333/NekoDrop',
  },
  {
    name: 'NekoPapa',
    meta: 'An exploration of AI companions — presence over cleverness.',
  },
  {
    name: 'Hisakazu.dev',
    meta: 'This site — Astro, statically generated, no tracking.',
    url: 'https://github.com/Hisakazu333/Hisakazu',
  },
];
---

<Base title="Zijie Huang">
  <header>
    <img class="avatar" src="/avatar.jpeg" alt="Zijie Huang" />
    <h1>Zijie Huang</h1>
    <p class="tagline">Independent developer, studying machine learning</p>
    <p class="email">
      <a href="mailto:huangzijie@cuyitech.com">huangzijie@cuyitech.com</a>
    </p>
  </header>

  <section>
    <h2>Publications</h2>
    <ul class="item-list">
      {
        publications.map((p) => (
          <li>
            <a class="item-title" href={p.url}>{p.title}</a>
            <span class="item-meta">{p.meta}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <h2>Projects</h2>
    <ul class="item-list">
      {
        projects.map((p) => (
          <li>
            {p.url ? (
              <a class="item-title" href={p.url}>{p.name}</a>
            ) : (
              <span class="item-title">{p.name}</span>
            )}
            <span class="item-meta">{p.meta}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <h2>Elsewhere</h2>
    <ul class="item-list">
      <li><a class="item-title" href="https://github.com/Hisakazu333">GitHub</a></li>
      <li><a class="item-title" href="mailto:huangzijie@cuyitech.com">Email</a></li>
    </ul>
  </section>
</Base>
