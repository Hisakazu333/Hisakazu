---
import Base from '../layouts/Base.astro';

const publications = [
  {
    title:
      'Self-Certification of Representation Adequacy: Sequential Certification at Minimum Task Loss',
    venue: 'arXiv:2608.02267 [cs.AI], Aug 2026',
    url: 'https://arxiv.org/abs/2608.02267',
  },
];

const projects = [
  {
    name: 'NekoPapa',
    desc: 'An exploration of AI companions — presence over cleverness.',
    url: 'https://github.com/Hisakazu333/nekopapa',
  },
  {
    name: 'NekoDrop',
    desc: 'A lightweight transfer-protocol experiment, built to last.',
    url: 'https://github.com/Hisakazu333/nekodrop',
  },
];
---

<Base title="Zijie Huang">
  <header>
    <img class="avatar" src="/avatar.jpeg" alt="Zijie Huang" width="72" height="72" />
    <h1>Zijie Huang</h1>
    <p class="tagline">Independent developer</p>
    <p>
      <a href="mailto:huangzijie@cuyitech.com">huangzijie@cuyitech.com</a>
    </p>
  </header>

  <p>
    I build quiet, useful tools, and I'm currently interested in machine learning.
    This page serves as my verified personal homepage.
  </p>

  <section>
    <h2>Publications</h2>
    <ul class="item-list">
      {
        publications.map((p) => (
          <li>
            <a href={p.url}>{p.title}</a>
            <span class="desc">{p.venue}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <h2>Projects</h2>
    <ul class="item-list">
      {
        projects.map((p) => (
          <li>
            <a href={p.url}>{p.name}</a>
            <span class="desc">{p.desc}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <h2>Elsewhere</h2>
    <ul class="item-list">
      <li><a href="https://github.com/Hisakazu333">GitHub</a></li>
      <li><a href="mailto:huangzijie@cuyitech.com">Email</a></li>
    </ul>
  </section>
</Base>
